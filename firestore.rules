rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Common helpers -----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFriend(userId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId))
      );
    }

    function groupDocPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupRecord(groupId) {
      let path = groupDocPath(groupId);
      return exists(path) ? get(path).data : null;
    }

    function groupAfterRecord(groupId) {
      let path = groupDocPath(groupId);
      return existsAfter(path) ? getAfter(path).data : null;
    }

    function isGroupMember(groupId) {
      let group = groupRecord(groupId);
      return isSignedIn() && group != null &&
        group.memberIds is list &&
        group.memberIds.hasAny([request.auth.uid]);
    }

    function isGroupAdmin(groupId) {
      let group = groupRecord(groupId);
      return isSignedIn() && group != null &&
        group.adminIds is list &&
        group.adminIds.hasAny([request.auth.uid]);
    }

    function isGroupOwner(groupId) {
      let group = groupRecord(groupId);
      return isSignedIn() && group != null &&
        group.createdBy == request.auth.uid;
    }

    function isPublicGroup(groupId) {
      let group = groupRecord(groupId);
      return group != null && group.isPublic == true;
    }

    function canModerateDojo(groupId) {
      return isGroupMember(groupId) &&
        (isGroupAdmin(groupId) || isGroupOwner(groupId));
    }

    function canReadGroupData(groupData) {
      // Keep query authorization expressible by array-contains/isPublic filters.
      return isSignedIn() && (
        request.auth.uid in groupData.memberIds ||
        groupData.isPublic == true
      );
    }

    function canCreateUserGroupLink(userId, groupId) {
      let group = groupAfterRecord(groupId);
      return isSignedIn() &&
        request.resource.data.groupId == groupId &&
        request.resource.data.keys().hasOnly(['groupId', 'joinedAt', 'isAdmin']) &&
        request.resource.data.joinedAt == request.time &&
        (
          isSelf(userId) ||
          (
            group != null &&
            group.createdBy == request.auth.uid &&
            group.memberIds is list &&
            group.memberIds.hasAny([userId]) &&
            group.adminIds is list &&
            group.adminIds.hasAny([request.auth.uid])
          ) ||
          (
            group != null &&
            group.adminIds is list &&
            group.adminIds.hasAny([request.auth.uid]) &&
            group.memberIds is list &&
            group.memberIds.hasAny([userId])
          )
        );
    }

    function validAssignmentStatus(status) {
      return status in [
        'AssignmentStatus.notStarted',
        'AssignmentStatus.inProgress',
        'AssignmentStatus.completed',
        'notStarted',
        'inProgress',
        'completed'
      ];
    }

    function userDocPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function userRecord(userId) {
      let path = userDocPath(userId);
      return exists(path) ? get(path).data : null;
    }

    function activeDojoMatches(dojoId) {
      let me = isSignedIn() ? userRecord(request.auth.uid) : null;
      return me != null &&
        me.activeExamDojoId != null &&
        me.activeExamDojoId == dojoId;
    }

    function activeDojoRole(dojoId) {
      let me = isSignedIn() ? userRecord(request.auth.uid) : null;
      return (me != null &&
        me.activeExamDojoId != null &&
        me.activeExamDojoId == dojoId)
        ? me.activeExamDojoRole
        : null;
    }

    function examDojoDocPath(dojoId) {
      return /databases/$(database)/documents/exam_dojos/$(dojoId);
    }

    function examDojoMemberDoc(dojoId, userId) {
      return /databases/$(database)/documents/exam_dojos/$(dojoId)/members/$(userId);
    }

    function examDojoRecord(dojoId) {
      let path = examDojoDocPath(dojoId);
      return (resource != null && resource.__name__ == path)
        ? resource.data
        : (request.resource != null && request.resource.__name__ == path)
          ? request.resource.data
          : exists(path) ? get(path).data : null;
    }

    function isExamDojoMember(dojoId) {
      return isSignedIn() && (
        activeDojoMatches(dojoId) ||
        (
          examDojoRecord(dojoId) != null &&
          examDojoRecord(dojoId).memberIds is list &&
          examDojoRecord(dojoId).memberIds.hasAny([request.auth.uid])
        ) ||
        exists(examDojoMemberDoc(dojoId, request.auth.uid))
      );
    }

    function isExamDojoAdmin(dojoId) {
      return isSignedIn() && (
        activeDojoRole(dojoId) == 'admin' ||
        (
          examDojoRecord(dojoId) != null &&
          examDojoRecord(dojoId).adminIds is list &&
          examDojoRecord(dojoId).adminIds.hasAny([request.auth.uid])
        ) ||
        (
          exists(examDojoMemberDoc(dojoId, request.auth.uid)) &&
          get(examDojoMemberDoc(dojoId, request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // --- Users collection and nested resources -----------------------------
    match /users/{userId} {
      allow read: if isSelf(userId) || (isFriend(userId) &&
        !resource.data.keys().hasAny(['fcmToken', 'fcmTokens', 'tokens']));
      allow create: if isSelf(userId) &&
        !request.resource.data.keys().hasAny(['fcmToken', 'fcmTokens', 'tokens']);
      allow update: if isSelf(userId) && (
        !request.resource.data.keys().hasAny(['fcmToken', 'fcmTokens', 'tokens']) ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['fcmToken', 'fcmTokens', 'tokens']));
      allow delete: if isSelf(userId);

      match /private/push {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId) &&
          request.resource.data.keys().hasOnly(['tokens', 'updatedAt']) &&
          request.resource.data.tokens is list &&
          request.resource.data.tokens.size() <= 100 &&
          request.resource.data.updatedAt == request.time;
      }

      match /subjects/{subjectId} {
        allow read, write: if isSelf(userId);
      }

      match /assignments/{assignmentId} {
        allow read, write: if isSelf(userId);
      }

      match /calendar_events/{eventId} {
        allow read, write: if isSelf(userId);
      }

      match /sessions/{sessionId} {
        allow read, write: if isSelf(userId);
      }

      match /studyBlocks/{blockId} {
        allow read, write: if isSelf(userId);
      }

      match /studySessions/{sessionId} {
        allow read, write: if isSelf(userId);
      }

      match /longTermGoals/{goalId} {
        allow read, write: if isSelf(userId);

        match /milestones/{milestoneId} {
          allow read, write: if isSelf(userId);
        }
      }

      match /friends/{friendId} {
        allow read: if isSelf(userId);

        allow create: if (
            isSelf(userId) &&
            request.resource.data.friendId == friendId &&
            request.resource.data.keys().hasOnly(['friendId', 'since']) &&
            request.resource.data.since == request.time
          ) || (
            isSignedIn() &&
            request.auth.uid == request.resource.data.friendId &&
            request.resource.data.friendId == friendId &&
            request.resource.data.keys().hasOnly(['friendId', 'since']) &&
            request.resource.data.since == request.time
          );

        allow update: if false; // friend docs are set-and-forget.

        allow delete: if isSelf(userId) ||
          (isSignedIn() && request.auth.uid == resource.data.friendId);
      }

      match /groups/{groupId} {
        allow read: if isSelf(userId) || isGroupMember(groupId) || isPublicGroup(groupId);

        allow create: if canCreateUserGroupLink(userId, groupId);

        allow update: if (
            (isSelf(userId) || isGroupAdmin(groupId)) &&
            request.resource.data.groupId == groupId &&
            request.resource.data.keys().hasOnly(['groupId', 'joinedAt', 'isAdmin']) &&
            request.resource.data.joinedAt == resource.data.joinedAt
          );

        allow delete: if isSelf(userId) || isGroupAdmin(groupId);
      }
    }

    // --- Friend requests ----------------------------------------------------
    match /friend_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'status', 'createdAt'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;

      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );

      allow update: if isSignedIn() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'status', 'createdAt', 'respondedAt'
        ]) &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.respondedAt == request.time;

      allow delete: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // --- User preference documents -----------------------------------------
    match /userPreferences/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /user_subjects/{userId} {
      allow read, write: if isSelf(userId);
    }

    // --- Standalone assignments (public feed) -------------------------------
    match /assignments/{assignmentId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // --- Groups root collection ---------------------------------------------
    match /groups/{groupId} {
      allow get, list: if canReadGroupData(resource.data);

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.hasAny([request.auth.uid]) &&
        request.resource.data.adminIds is list &&
        request.resource.data.adminIds.hasAny([request.auth.uid]) &&
        request.resource.data.createdAt is timestamp;

      allow update: if isGroupAdmin(groupId);
      allow delete: if isGroupAdmin(groupId);

      match /assignments/{assignmentId} {
        allow read: if isGroupMember(groupId) || isGroupAdmin(groupId);

        allow create: if isGroupAdmin(groupId) &&
          request.resource.data.groupId == groupId;

        allow delete: if isGroupAdmin(groupId);

        allow update: if isGroupAdmin(groupId) ||
          (
            isGroupMember(groupId) &&
            resource.data.groupId == groupId &&
            request.resource.data.groupId == groupId &&
            resource.data.diff(request.resource.data).changedKeys()
              .hasOnly(['userCompletion', 'status', 'updatedAt']) &&
            validAssignmentStatus(request.resource.data.status) &&
            request.resource.data.userCompletion is map &&
            request.resource.data.userCompletion[request.auth.uid] is bool &&
            resource.data.userCompletion.diff(request.resource.data.userCompletion)
              .changedKeys().hasOnly([request.auth.uid])
          );
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId) || isGroupAdmin(groupId);

        allow create: if isGroupMember(groupId) &&
          request.resource.data.groupId == groupId &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'groupId',
            'senderId',
            'senderName',
            'senderPhotoUrl',
            'text',
            'sentAt',
            'editedAt',
            'replyToMessageId',
            'replyToSenderId',
            'replyToSenderName',
            'replyPreview'
          ]) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.sentAt == request.time &&
          request.resource.data.editedAt == null &&
          (!('replyPreview' in request.resource.data) || (request.resource.data.replyPreview is string && request.resource.data.replyPreview.size() <= 160));

        allow update: if isGroupMember(groupId) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.keys().hasAll([
            'groupId',
            'senderId',
            'senderName',
            'senderPhotoUrl',
            'text',
            'sentAt',
            'editedAt'
          ]) &&
          resource.data.diff(request.resource.data).changedKeys().hasOnly([
            'text',
            'editedAt'
          ]) &&
          request.resource.data.editedAt == request.time;

        allow delete: if isGroupAdmin(groupId) ||
          (isGroupMember(groupId) &&
            resource.data.senderId == request.auth.uid);
      }

      match /resources/{resourceId} {
        allow read: if isGroupMember(groupId) || isGroupAdmin(groupId);

        allow create: if isGroupMember(groupId) &&
          request.resource.data.keys().hasOnly([
            'name',
            'storagePath',
            'downloadUrl',
            'mimeType',
            'extension',
            'sizeBytes',
            'uploadedBy',
            'uploadedByName',
            'createdAt',
            'originalFileName'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.storagePath is string &&
          request.resource.data.downloadUrl is string &&
          request.resource.data.mimeType is string &&
          request.resource.data.extension in [
            'pdf',
            'doc',
            'docx',
            'ppt',
            'pptx',
            'jpg',
            'jpeg',
            'png',
            'webp'
          ] &&
          request.resource.data.sizeBytes is int &&
          request.resource.data.sizeBytes > 0 &&
          request.resource.data.sizeBytes <= 25 * 1024 * 1024 &&
          request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.uploadedByName is string &&
          request.resource.data.uploadedByName.size() > 0 &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.storagePath.matches(
            'dojos/' + groupId + '/resources/' + resourceId + '/[^/]+'
          ) &&
          request.resource.data.createdAt == request.time &&
          (
            !('originalFileName' in request.resource.data) ||
            request.resource.data.originalFileName is string
          );

        allow update: if false;

        allow delete: if isGroupAdmin(groupId) ||
          isGroupOwner(groupId) ||
          (isGroupMember(groupId) &&
            resource.data.uploadedBy == request.auth.uid);
      }

      match /pins/{pinId} {
        allow read: if isGroupMember(groupId);
        allow create: if canModerateDojo(groupId) && request.resource.data.type in ['message','resource','announcement'] && request.resource.data.targetId is string && request.resource.data.pinnedBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow delete: if canModerateDojo(groupId);
        allow update: if false;
      }
      match /announcements/{announcementId} {
        allow read: if isGroupMember(groupId);
        allow create: if canModerateDojo(groupId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160 && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000 && request.resource.data.createdAt == request.time;
        allow delete: if canModerateDojo(groupId);
        allow update: if false;
      }
    }

    // --- Legacy collection for shared group assignments ---------------------
    match /group_assignments/{assignmentId} {
      allow read: if isGroupMember(resource.data.groupId) ||
        isGroupAdmin(resource.data.groupId);

      allow create: if isGroupAdmin(request.resource.data.groupId);
      allow delete: if isGroupAdmin(resource.data.groupId);

      allow update: if isGroupAdmin(resource.data.groupId) ||
        (
          isGroupMember(resource.data.groupId) &&
          resource.data.diff(request.resource.data).changedKeys()
            .hasOnly(['submissions', 'updatedAt']) &&
          request.resource.data.updatedAt is timestamp
        );
    }

    // --- Exam Dojo groups ---------------------------------------------------
    match /exam_dojos/{dojoId} {
      allow read: if isExamDojoMember(dojoId);

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.hasAny([request.auth.uid]) &&
        request.resource.data.adminIds is list &&
        request.resource.data.adminIds.hasAny([request.auth.uid]) &&
        request.resource.data.createdAt is timestamp;

      allow update, delete: if isExamDojoAdmin(dojoId);

      match /members/{memberId} {
        allow read: if isSignedIn() && (
          memberId == request.auth.uid ||
          (resource != null && resource.data.userId == request.auth.uid)
        );
        allow write: if isExamDojoAdmin(dojoId);
      }

      match /roadmap_snapshots/{snapshotId} {
        allow read: if isExamDojoMember(dojoId);
        allow write: if false;
      }
    }

    // --- Default deny -------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
